<RegisterScreen>:
    name: "register_screen"
    canvas.before:
        Color:
            rgba: BG_VOID
        Rectangle:
            pos: self.pos
            size: self.size

    PanelCard:
        orientation: "vertical"
        size_hint: None, None
        size: "420dp", "520dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        padding: "28dp"
        spacing: "8dp"
        bg_color: SURFACE_PANEL
        border_color: BORDER_CONDUIT

        Button:
            text: "←  BACK TO LOGIN"
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: TEXT_MUTED
            size_hint_y: None
            height: "28dp"
            halign: "left"
            text_size: self.size
            on_release: root.go_login()

        Label:
            text: "CREATE PILOT"
            font_size: "24sp"
            bold: True
            size_hint_y: None
            height: "34dp"
            halign: "center"
            text_size: self.size

        Label:
            text: "New accounts initialize at 1000 MMR."
            font_size: "13sp"
            color: TEXT_MUTED
            size_hint_y: None
            height: "24dp"
            halign: "center"
            text_size: self.size

        CyberInput:
            id: callsign
            hint_text: "Callsign (3–16 chars)"
            size_hint_y: None
            height: "44dp"

        CyberInput:
            id: email
            hint_text: "Email / Student ID"
            size_hint_y: None
            height: "44dp"

        CyberInput:
            id: password
            hint_text: "Password"
            password: True
            size_hint_y: None
            height: "44dp"

        CyberInput:
            id: confirm
            hint_text: "Confirm Password"
            password: True
            size_hint_y: None
            height: "44dp"

        Label:
            text: root.status_text
            color: root.status_color
            font_size: "12sp"
            size_hint_y: None
            height: "22dp"
            halign: "center"
            text_size: self.size

        CyberButton:
            text: "REGISTER PILOT"
            size_hint_y: None
            height: "46dp"
            bg_color: ACCENT_CYAN
            border_color: ACCENT_CYAN
            color: 0.02, 0.05, 0.08, 1
            on_release: root.do_register()
